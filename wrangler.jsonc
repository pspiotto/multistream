{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multistream",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-18",
  "assets": { "directory": "./public" },
  "routes": [{ "pattern": "stream.spiot.to", "custom_domain": true }],
  "workers_dev": false,
  // Per-address cap on the /api lookups (src/worker.js); the hls.js variant relay is exempt.
  "ratelimits": [{ "name": "RL", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  "observability": { "enabled": true }
}
